# Global Settings
Host *
  IgnoreUnknown UseKeychain
  AddressFamily inet
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

# GitHub - purplebyte
Host github
  HostName github.com
  User git
  IdentityFile ~/.ssh/keys/github
  IdentitiesOnly yes

# Gitea Homelab
Host gitea
  HostName gitea-ssh.tailb100ad.ts.net
  Port 22
  User git
  IdentityFile ~/.ssh/keys/gitea
  IdentitiesOnly yes

# Tailscale Homelab Server
Host nuc
  HostName nuc
  User nelio
  IdentityFile ~/.ssh/keys/homelab
  IdentitiesOnly yes
  SetEnv TERM=xterm-256color

# Gitlab
Host eth
  HostName gitlab.inf.ethz.ch
  User git
  IdentityFile ~/.ssh/keys/gitlab
  IdentitiesOnly yes
