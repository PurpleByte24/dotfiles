# Global settings
AddressFamily inet
AddKeysToAgent yes
UseKeychain yes

# GitHub - purplebyte
Host github
  HostName github.com
  User git
  IdentityFile ~/.ssh/keys/github
  IdentitiesOnly yes

# Gitea Homelab
Host gitea
  HostName gitea-ssh.tailb100ad.ts.net
  Port 22
  User git
  IdentityFile ~/.ssh/keys/gitea
  IdentitiesOnly yes

# Tailscale Homelab Server
Host nuc
  HostName nuc
  User nelio
  IdentityFile ~/.ssh/keys/homelab
  IdentitiesOnly yes
  SetEnv TERM=xterm-256color

