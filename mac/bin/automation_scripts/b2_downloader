#!/bin/bash

# --- Configuration ---
ENDPOINT="s3.eu-central-003.backblazeb2.com"
BUCKET="grades-backup-bucket"
WORK_DIR="$HOME/mongo_backups_workspace"

# --- Credentials ---
export AWS_SHARED_CREDENTIALS_FILE="$HOME/.aws/b2_creds"

# 1. Setup Workspace
mkdir -p "$WORK_DIR"

# 2. Tool Check
for tool in aws docker; do
    if ! command -v "$tool" &> /dev/null; then echo "❌ Missing $tool"; exit 1; fi
done

echo "🚀 Fetching backups..."
aws s3 ls "s3://$BUCKET" --endpoint-url "https://$ENDPOINT"

echo -n "👉 Enter filename: "
read -r FILENAME
[ -z "$FILENAME" ] && exit 1

TARGET_FOLDER="${FILENAME%.gz}"
FULL_PATH="$WORK_DIR/$FILENAME"
EXTRACT_PATH="$WORK_DIR/$TARGET_FOLDER"

echo "📥 Downloading to $WORK_DIR..."
aws s3 cp "s3://$BUCKET/$FILENAME" "$FULL_PATH" --endpoint-url "https://$ENDPOINT"

echo "📦 Processing inside $WORK_DIR..."
rm -rf "$EXTRACT_PATH" && mkdir -p "$EXTRACT_PATH"

# We map the Workarea folder to /data
# Docker will now drop its 'db' and 'configdb' folders inside B2_Workarea
docker run --rm -v "$WORK_DIR:/data" mongo:6.0 bash -c "
    set -e
    # Using /data as dbpath keeps all 'mess' inside your Workarea folder
    mongod --dbpath=/data --noauth --bind_ip_all --quiet > /dev/null 2>&1 &
    MONGOD_PID=\$!
    
    until mongosh --quiet --eval 'db.runCommand({ping:1})' > /dev/null 2>&1; do sleep 1; done

    mongorestore --quiet --archive=\"/data/$FILENAME\" --gzip > /dev/null 2>&1
    
    DBS=\$(mongosh --quiet --eval 'db.getMongo().getDBNames().filter(n => ![\"admin\",\"config\",\"local\"].includes(n)).join(\",\")')
    
    IFS=','
    for DB in \$DBS; do
        COLLECTIONS=\$(mongosh --quiet --eval \"db.getSiblingDB('\$DB').getCollectionNames().join(',')\")
        for COLL in \$COLLECTIONS; do
            mongoexport --quiet --db=\"\$DB\" --collection=\"\$COLL\" --out=\"/data/$TARGET_FOLDER/\$COLL.json\" --jsonArray > /dev/null 2>&1
        done
    done

    kill \$MONGOD_PID > /dev/null 2>&1
"

if [ -d "$EXTRACT_PATH" ] && [ "$(ls -A "$EXTRACT_PATH")" ]; then
    echo "✅ Success! JSON files are in: Desktop/B2_Workarea/$TARGET_FOLDER"
    rm -f "$FULL_PATH"
    open "$EXTRACT_PATH"
else
    echo "❌ Extraction failed."
fi
