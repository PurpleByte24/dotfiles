#!/bin/bash

# Define the path to your config
KUBE_CONFIG="$HOME/.config/kube/config"

# 1. Check if the config file exists
if [ ! -f "$KUBE_CONFIG" ]; then
    echo "❌ Error: Config file not found at $KUBE_CONFIG"
    exit 1
fi

echo "🚀 Opening PostgreSQL tunnel to ThinkCentre..."
echo "📍 Local: localhost:5432 -> Remote: svc/postgres:5432"
echo "Press Ctrl+C to stop the tunnel."

# 2. Run the command using the specific config
KUBECONFIG="$KUBE_CONFIG" kubectl port-forward -n infra svc/postgres 5432:5432

