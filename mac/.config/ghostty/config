# ── Font ──────────────────────────────────────────────────
font-size = 14
font-family = "JetBrains Mono"

# ── Window ────────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-save-state = never
background-opacity = 1.0

# ── Cursor ────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Shell integration ─────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Keybinds (kept minimal — yabai/skhd own window management) ──
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left_bracket=goto_split:left
keybind = cmd+alt+right_bracket=goto_split:right

# ── Scrollback ────────────────────────────────────────────
scrollback-limit = 10000
theme = Catppuccin Mocha
