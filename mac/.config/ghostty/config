# ── Font ──────────────────────────────────────────────────
font-size = 14
font-family = "JetBrains Mono"

# ── Window ────────────────────────────────────────────────
window-padding-x = 10
window-padding-y = 10
window-decoration = true
window-save-state = never
background-opacity = 1.0

# ── Cursor ────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Shell integration ─────────────────────────────────────
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ── Keybinds ───────────────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+left_bracket=previous_tab
keybind = cmd+shift+right_bracket=next_tab
keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+j=new_split:down
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+l=new_split:right
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+l=goto_split:right
keybind = cmd+r=reload_config

# ── Scrollback ────────────────────────────────────────────
scrollback-limit = 10000
theme = Catppuccin Mocha

# ── New Tab behaviour ─────────────────────────────────────
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true
