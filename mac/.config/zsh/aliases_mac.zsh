# My Aliases For Shell Scripts

s_path="$HOME/bin/automation_scripts"

alias python=python3
alias pip=pip3
alias g=rg
alias f=fd
alias e="eza -lah --no-quotes"
alias et="eza -aT --no-quotes -I '.git|node_modules|.venv|__pycache__|dist'"
alias b="bat --theme='Catppuccin Mocha'"

alias CLEAN_TEX="$s_path/cleanup_tex_aux_files"
alias CF="$s_path/initialize_CF"
alias RFF="$s_path/run_fastfetch"
alias PUSH_EXT="$s_path/push_version_to_vsx"
alias MA_SCRIPT="$s_path/ma_script"
alias MONGO_TUNNEL="$s_path/mongo-tunnel"
alias PG_TUNNEL="$s_path/pg-tunnel"
alias B2_DL="$s_path/b2_downloader"
alias cn="cargo new --vcs none"
alias o_backup="$s_path/obsidian_backup"

