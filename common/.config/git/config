[includeIf "gitdir:~/repos/github/"]
  path = ~/.config/git/config-github

[includeIf "gitdir:~/repos/gitea/"]
  path = ~/.config/git/config-gitea

[filter "lfs"]
  clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim
  pager = delta

[commit]
	template = /Users/neliogautschi/.stCommitMsg

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
